# ───────── DETAIL REEL AI — konfiguracja ─────────
# Skopiuj do .env i uzupełnij.

# Baza danych PostgreSQL
DATABASE_URL="postgresql://detailreel:detailreel@localhost:5432/detailreel?schema=public"

# Redis (kolejka zadań BullMQ — analiza, render)
REDIS_URL="redis://localhost:6379"

# Adres aplikacji (linki do akceptacji klienta)
APP_URL="http://localhost:3000"

# Sekret do podpisywania (min. 32 znaki) — wygeneruj: openssl rand -hex 32
APP_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ───────── Storage ─────────
# local = pliki w katalogu STORAGE_DIR; s3 = dowolny storage zgodny z S3
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
# S3_BUCKET=""
# S3_REGION="eu-central-1"
# S3_ENDPOINT=""            # np. https://<account>.r2.cloudflarestorage.com albo MinIO
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="true"

# Limity uploadu
MAX_UPLOAD_MB="1024"
MAX_VIDEO_DURATION_SEC="600"

# ───────── AI: analiza multimodalna (Claude API) ─────────
# Bez klucza aplikacja działa w trybie heurystycznym (tylko pomiary techniczne),
# wyraźnie oznaczonym w interfejsie.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
# Maksymalna liczba klatek wysyłanych do modelu na jedną analizę
AI_MAX_FRAMES="24"

# ───────── Transkrypcja mowy (język polski) ─────────
# provider: openai (dowolne API zgodne z /v1/audio/transcriptions, np. OpenAI, Groq,
#           faster-whisper-server) | whispercpp (lokalny whisper.cpp) | none
TRANSCRIPTION_PROVIDER="none"
TRANSCRIPTION_API_URL="https://api.openai.com/v1/audio/transcriptions"
TRANSCRIPTION_API_KEY=""
TRANSCRIPTION_MODEL="whisper-1"
# whisper.cpp (opcjonalnie, offline)
# WHISPER_CPP_BIN="/usr/local/bin/whisper-cli"
# WHISPER_CPP_MODEL="/models/ggml-large-v3-turbo.bin"

# ───────── Muzyka ─────────
# Opcjonalny katalog z legalnie licencjonowaną muzyką (mp3/wav/m4a), importowany do biblioteki
# MUSIC_LIBRARY_DIR="./music-library"

# ───────── Limity użycia (na użytkownika / godzinę) ─────────
RATE_LIMIT_AI_PER_HOUR="40"
RATE_LIMIT_UPLOADS_PER_HOUR="200"
RATE_LIMIT_RENDERS_PER_HOUR="60"

# Worker: liczba równoległych zadań
WORKER_CONCURRENCY="2"

# FFmpeg (opcjonalnie inne ścieżki)
# FFMPEG_PATH="ffmpeg"
# FFPROBE_PATH="ffprobe"

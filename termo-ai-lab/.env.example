# Konfiguracja serwera TERMO AI LAB (plik .env NIE trafia do repozytorium).
# Klucz API jest używany WYŁĄCZNIE po stronie serwera — nigdy w kodzie przeglądarki.

# Klucz do API Anthropic (Claude). Bez niego aplikacja działa w trybie demonstracyjnym.
ANTHROPIC_API_KEY=

# Model używany do oceny poleceń (domyślnie claude-opus-5-5).
AI_MODEL=claude-opus-5-5

# Port serwera (domyślnie 8787).
PORT=8787

# Dozwolone źródła (CORS) dla aplikacji uruchamianej z innego adresu, np. Android (Capacitor).
# Lista rozdzielona przecinkami. Przykład: https://localhost,capacitor://localhost
ALLOWED_ORIGINS=

# Limit zapytań do AI na adres IP w ciągu 10 minut (ochrona przed nadużyciem kosztów).
AI_RATE_LIMIT=40

# --- Zmienne dla buildu aplikacji (frontend) ---
# Adres serwera API, jeśli aplikacja jest hostowana osobno (np. w APK). Domyślnie ta sama domena.
# VITE_API_BASE_URL=https://twoj-serwer.example.com
